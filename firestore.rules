rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{userId}/calculations/{calcId}
// Document ID: auto-generated or timestamp-based string
// Fields:
//   - userId: string (required, must match request.auth.uid)
//   - title: string (required, max 100 chars)
//   - createdAt: timestamp or string (required)
//   - inputs: map (required; current field names)
//       - repairCost: number (>= 0)
//       - excess: number (>= 0)
//       - currentNcd: number (0 <= ncd <= 50)
//       - ncdProtector: bool
//       - currentPremium: number (>= 0)
//   - results: map (required)
//       - recommendation: string in ['CLAIM', 'SELF_PAY', 'NEUTRAL']
//       - savings: number
//       - breakEvenCost: number
//
// Collection: users/{userId}/vehicles/primary
// Fields:
//   - userId: string (required, must match request.auth.uid)
//   - label: string (max 40 chars)
//   - insuranceRenewal, coeExpiry, loanReview: "YYYY-MM-DD" or empty string
//   - currentPremium, excess: number or empty string
//   - currentNcd: number from 0 to 50, or empty string
//   - updatedAt: string
//
// Collection: reminderSubscriptions/{subscriptionId}
// Server-only. Client access is blocked by the default deny rule.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidCalculation(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.inputs is map &&
             data.inputs.repairCost is number && data.inputs.repairCost >= 0 &&
             data.inputs.excess is number && data.inputs.excess >= 0 &&
             data.inputs.currentNcd is number && data.inputs.currentNcd >= 0 && data.inputs.currentNcd <= 50 &&
             data.inputs.ncdProtector is bool &&
             data.inputs.currentPremium is number && data.inputs.currentPremium > 0 &&
             data.inputs.horizonYears in [3, 5] &&
             data.inputs.baseGrowthRate is number && data.inputs.baseGrowthRate >= -20 && data.inputs.baseGrowthRate <= 50 &&
             data.inputs.discountRate is number && data.inputs.discountRate >= 0 && data.inputs.discountRate <= 20 &&
             data.inputs.liability in ['at_fault', 'non_fault', 'partial_fault'] &&
             data.inputs.thirdPartyClaim is bool &&
             data.inputs.workshopType in ['authorized', 'independent'] &&
             data.inputs.youngDriverInvolved is bool &&
             data.inputs.repairType in ['general', 'windscreen'] &&
             data.results is map &&
             data.results.recommendation is string &&
             data.results.recommendation in ['claim', 'self-pay', 'CLAIM', 'SELF_PAY', 'NEUTRAL'] &&
             data.results.savings is number &&
             data.results.breakEvenCost is number;
    }

    function isOptionalDate(value) {
      return value is string && (value == '' || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function isOptionalAmount(value) {
      return (value is string && value == '') || (value is number && value >= 0 && value <= 100000);
    }

    function isValidVehicle(data, userId) {
      return data.keys().hasOnly(['userId', 'label', 'insuranceRenewal', 'coeExpiry', 'loanReview',
                                  'currentPremium', 'currentNcd', 'excess', 'updatedAt']) &&
             data.userId == userId &&
             data.label is string && data.label.size() <= 40 &&
             isOptionalDate(data.insuranceRenewal) &&
             isOptionalDate(data.coeExpiry) &&
             isOptionalDate(data.loanReview) &&
             isOptionalAmount(data.currentPremium) &&
             isOptionalAmount(data.excess) &&
             ((data.currentNcd is string && data.currentNcd == '') ||
              (data.currentNcd is number && data.currentNcd >= 0 && data.currentNcd <= 50)) &&
             data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    // Saved car details: one document per user
    match /users/{userId}/vehicles/{vehicleId} {
      allow read, delete: if isOwner(userId) && vehicleId == 'primary';
      allow create, update: if isOwner(userId) && vehicleId == 'primary' &&
                               isValidVehicle(request.resource.data, userId);
    }

    // User calculations subcollection
    match /users/{userId}/calculations/{calcId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidCalculation(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidCalculation(request.resource.data, userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId);
    }
  }
}
