# Google OAuth Credentials (managed via Identity Platform / GCP)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Firebase Client SDK Configuration (Safe for client-side public use)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id


# Email Reminders (server-side only; reminders stay disabled until the first four are set)
RESEND_API_KEY=your_resend_api_key_here
REMINDER_FROM_EMAIL=ClaimWise SG <reminders@your-verified-domain.example>
REMINDER_SITE_URL=https://your-public-site.example
# Generate with: openssl rand -hex 32
REMINDER_TOKEN_SECRET=at_least_32_random_characters
# Service account allowed to call /api/reminders/dispatch with a Google ID token
REMINDER_SCHEDULER_EMAIL=reminder-scheduler@your_project.iam.gserviceaccount.com
